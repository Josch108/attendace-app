# General configuration
ENVIRONMENT=development
PROJECT_NAME="Smart Attendance System"

# Database connection (defaults to local SQLite, or configure PostgreSQL)
# SQLite example: sqlite:///./attendance.db
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/attendance_db
DATABASE_URL=sqlite:///./attendance.db

# Local storage path for student face images
STORAGE_PATH=./data/students

# Detection and attendance parameters
ABSENCE_TIMEOUT_SECONDS=45
FACE_MATCH_THRESHOLD=0.50
FACE_CONFIRMATION_COUNT=3
MODEL_VERSION="insightface/buffalo_l"
